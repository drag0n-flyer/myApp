diff --git a/sdk/objc/api/peerconnection/RTCOpusInfo.h b/sdk/objc/api/peerconnection/RTCOpusInfo.h
new file mode 100644
index 0000000..6c38b1d
--- /dev/null
+++ b/sdk/objc/api/peerconnection/RTCOpusInfo.h
@@ -0,0 +1,47 @@
+/*
+ *  Application patch (tools/webrtc/patches/0003): reports what the Opus inside
+ *  this WebRTC build can do, so the app and its tests can check the build
+ *  instead of trusting it.
+ */
+
+#import <Foundation/Foundation.h>
+
+#import "sdk/objc/base/RTCMacros.h"
+
+NS_ASSUME_NONNULL_BEGIN
+
+RTC_OBJC_EXPORT
+@interface RTC_OBJC_TYPE (RTCOpusInfo) : NSObject
+
+/** libopus version string, for example "libopus 1.6". */
+@property(class, nonatomic, readonly) NSString *opusVersion;
+
+/** YES if the deep packet-loss concealment changes decoded audio. */
+@property(class, nonatomic, readonly) BOOL deepPLCActive;
+
+/** YES if the OSCE speech enhancement (LACE, NoLACE) changes decoded audio. */
+@property(class, nonatomic, readonly) BOOL osceActive;
+
+/** YES if the OSCE bandwidth extension changes decoded audio. */
+@property(class, nonatomic, readonly) BOOL bweActive;
+
+/** The complexity of a decoder made the way WebRTC makes one (48 kHz, mono),
+ *  or -1 if no decoder could be made. */
+@property(class, nonatomic, readonly) NSInteger webRTCDecoderComplexity;
+
+/** The field trial name that turns on Opus packet-loss concealment, compiled
+ *  in from tools/webrtc/VERSION (FIELD_TRIAL_OPUS_PLC). */
+@property(class, nonatomic, readonly) NSString *opusPLCFieldTrial;
+
+/** The packet length in ms the Opus encoder uses for an SDP `ptime` value:
+ *  the first supported length at or above `ptime`, the longest supported one
+ *  if `ptime` is larger, and 0 if the encoder rejects the format. */
++ (NSInteger)encoderFrameMsForPtime:(NSInteger)ptime;
+
+/** The longest packet length in ms the encoder accepts: 120, or 60 when WebRTC
+ *  is built without 120 ms support. */
+@property(class, nonatomic, readonly) NSInteger maxPacketMs;
+
+@end
+
+NS_ASSUME_NONNULL_END
diff --git a/sdk/objc/api/peerconnection/RTCOpusInfo.mm b/sdk/objc/api/peerconnection/RTCOpusInfo.mm
new file mode 100644
index 0000000..223acf2
--- /dev/null
+++ b/sdk/objc/api/peerconnection/RTCOpusInfo.mm
@@ -0,0 +1,70 @@
+/*
+ *  Application patch (tools/webrtc/patches/0003). See RTCOpusInfo.h.
+ */
+
+#import "RTCOpusInfo.h"
+
+#include <map>
+#include <optional>
+#include <string>
+
+#include "api/audio_codecs/audio_format.h"
+#include "api/audio_codecs/opus/audio_encoder_opus.h"
+#include "modules/audio_coding/codecs/opus/opus_interface.h"
+
+#import "components/app/opus_probe.h"
+
+#ifndef APP_OPUS_PLC_TRIAL
+#error "APP_OPUS_PLC_TRIAL must be defined (gn arg app_opus_plc_trial, from tools/webrtc/VERSION)"
+#endif
+
+@implementation RTC_OBJC_TYPE (RTCOpusInfo)
+
++ (NSString *)opusVersion {
+  const char *v = app_opus_version();
+  return v ? [NSString stringWithUTF8String:v] : @"";
+}
+
++ (BOOL)deepPLCActive {
+  static const BOOL active = app_opus_deep_plc_active() == 1;
+  return active;
+}
+
++ (BOOL)osceActive {
+  static const BOOL active = app_opus_osce_active() == 1;
+  return active;
+}
+
++ (BOOL)bweActive {
+  static const BOOL active = app_opus_bwe_active() == 1;
+  return active;
+}
+
++ (NSInteger)webRTCDecoderComplexity {
+  OpusDecInst *inst = nullptr;
+  if (WebRtcOpus_DecoderCreate(&inst, /*channels=*/1, /*sample_rate_hz=*/48000) != 0 || !inst) {
+    return -1;
+  }
+  const int complexity = WebRtcOpus_DecoderGetComplexity(inst);
+  WebRtcOpus_DecoderFree(inst);
+  return complexity;
+}
+
++ (NSString *)opusPLCFieldTrial {
+  return @APP_OPUS_PLC_TRIAL;
+}
+
++ (NSInteger)encoderFrameMsForPtime:(NSInteger)ptime {
+  webrtc::SdpAudioFormat format("opus", 48000, 2, {{"ptime", std::to_string(ptime)}});
+  std::optional<webrtc::AudioEncoderOpusConfig> config =
+      webrtc::AudioEncoderOpus::SdpToConfig(format);
+  return config ? config->frame_size_ms : 0;
+}
+
++ (NSInteger)maxPacketMs {
+  // WebRTC rounds an unsupported ptime up to the longest supported length, so
+  // asking for 120 reports 120 with 120 ms support and 60 without.
+  return [self encoderFrameMsForPtime:120];
+}
+
+@end
