diff --git a/sdk/android/api/org/webrtc/OpusVoiceEncoder.java b/sdk/android/api/org/webrtc/OpusVoiceEncoder.java
new file mode 100644
index 0000000..70b20fc
--- /dev/null
+++ b/sdk/android/api/org/webrtc/OpusVoiceEncoder.java
@@ -0,0 +1,82 @@
+/*
+ *  Application patch (tools/webrtc/patches/0008): an Opus encoder for voice
+ *  notes, for phones whose platform has no Opus MediaCodec encoder (the API 29
+ *  AOSP image has none). It uses the libopus inside this library, so no opus_*
+ *  symbol has to be exported.
+ *
+ *  Fixed format: 16 kHz, mono, 16 kbps, 20 ms frames, OPUS_APPLICATION_VOIP.
+ *  The first constructor loads libjingle_peerconnection_so if it is not loaded.
+ *  Each method is synchronized; close() frees the native encoder.
+ */
+
+package org.webrtc;
+
+import org.jni_zero.NativeMethods;
+
+public final class OpusVoiceEncoder implements AutoCloseable {
+  public static final int SAMPLE_RATE = 16000;
+  public static final int CHANNELS = 1;
+  public static final int BIT_RATE = 16000;
+  /** Samples per channel in one 20 ms frame. */
+  public static final int FRAME_SAMPLES = 320;
+  /** Bytes of 16-bit little-endian PCM in one frame. */
+  public static final int FRAME_BYTES = FRAME_SAMPLES * 2;
+
+  private long encoder;
+
+  /** @throws IllegalStateException if libopus cannot create the encoder */
+  public OpusVoiceEncoder() {
+    // Idempotent: a no-op when PeerConnectionFactory.initialize already loaded it.
+    System.loadLibrary("jingle_peerconnection_so");
+    encoder = OpusVoiceEncoderJni.get().create(SAMPLE_RATE, CHANNELS, BIT_RATE);
+    if (encoder == 0) {
+      throw new IllegalStateException("opus_encoder_create failed");
+    }
+  }
+
+  /** The encoder's lookahead in 48 kHz samples (the Ogg Opus pre-skip): 312 here. */
+  public synchronized int preSkip() {
+    return OpusVoiceEncoderJni.get().preSkip(handle());
+  }
+
+  /**
+   * Encodes one frame: {@link #FRAME_BYTES} bytes of 16-bit little-endian mono PCM starting at
+   * {@code offset}. Returns the Opus packet.
+   *
+   * @throws IllegalArgumentException if fewer than FRAME_BYTES bytes follow offset
+   * @throws IllegalStateException if libopus reports an error or the encoder is closed
+   */
+  public synchronized byte[] encode(byte[] pcm, int offset) {
+    if (offset < 0 || pcm.length - offset < FRAME_BYTES) {
+      throw new IllegalArgumentException("need " + FRAME_BYTES + " bytes at offset " + offset);
+    }
+    byte[] packet = OpusVoiceEncoderJni.get().encode(handle(), pcm, offset);
+    if (packet == null) {
+      throw new IllegalStateException("opus_encode failed");
+    }
+    return packet;
+  }
+
+  @Override
+  public synchronized void close() {
+    if (encoder != 0) {
+      OpusVoiceEncoderJni.get().free(encoder);
+      encoder = 0;
+    }
+  }
+
+  private long handle() {
+    if (encoder == 0) {
+      throw new IllegalStateException("encoder is closed");
+    }
+    return encoder;
+  }
+
+  @NativeMethods
+  interface Natives { // Parameters are not named native<Class>: jni_zero would make that a pointer type.
+    long create(int sampleRate, int channels, int bitRate);
+    int preSkip(long handle);
+    byte[] encode(long handle, byte[] pcm, int offset);
+    void free(long handle);
+  }
+}
diff --git a/sdk/android/src/jni/app/opus_voice_encoder.cc b/sdk/android/src/jni/app/opus_voice_encoder.cc
new file mode 100644
index 0000000..0f2733e
--- /dev/null
+++ b/sdk/android/src/jni/app/opus_voice_encoder.cc
@@ -0,0 +1,92 @@
+/*
+ *  Application patch (tools/webrtc/patches/0008). See
+ *  api/org/webrtc/OpusVoiceEncoder.java.
+ */
+
+#include <jni.h>
+
+#include <cstdint>
+
+#include "rtc_base/checks.h"
+#include "sdk/android/generated_app_opus_jni/OpusVoiceEncoder_jni.h"
+#include "third_party/jni_zero/jni_zero.h"
+#include "third_party/opus/src/include/opus.h"
+
+namespace webrtc {
+namespace jni {
+
+namespace {
+// One 20 ms frame at 16 kHz mono.
+constexpr int kFrameSamples = 320;
+// Far above a 20 ms packet at 16 kbps (40 bytes); RFC 6716's limit per frame.
+constexpr int kMaxPacketBytes = 1275;
+}  // namespace
+
+static jlong JNI_OpusVoiceEncoder_Create(JNIEnv* env,
+                                         jint sample_rate,
+                                         jint channels,
+                                         jint bit_rate) {
+  int error = OPUS_OK;
+  OpusEncoder* encoder =
+      opus_encoder_create(sample_rate, channels, OPUS_APPLICATION_VOIP, &error);
+  if (error != OPUS_OK || encoder == nullptr) {
+    return 0;
+  }
+  if (opus_encoder_ctl(encoder, OPUS_SET_BITRATE(bit_rate)) != OPUS_OK ||
+      opus_encoder_ctl(encoder, OPUS_SET_SIGNAL(OPUS_SIGNAL_VOICE)) != OPUS_OK) {
+    opus_encoder_destroy(encoder);
+    return 0;
+  }
+  return reinterpret_cast<jlong>(encoder);
+}
+
+static jint JNI_OpusVoiceEncoder_PreSkip(JNIEnv* env, jlong handle) {
+  OpusEncoder* encoder = reinterpret_cast<OpusEncoder*>(handle);
+  opus_int32 lookahead = 0;
+  opus_int32 rate = 0;
+  if (opus_encoder_ctl(encoder, OPUS_GET_LOOKAHEAD(&lookahead)) != OPUS_OK ||
+      opus_encoder_ctl(encoder, OPUS_GET_SAMPLE_RATE(&rate)) != OPUS_OK || rate <= 0) {
+    return -1;
+  }
+  // Ogg Opus counts pre-skip in 48 kHz samples (RFC 7845 section 4.2).
+  return static_cast<jint>(lookahead * (48000 / rate));
+}
+
+static jni_zero::ScopedJavaLocalRef<jbyteArray> JNI_OpusVoiceEncoder_Encode(
+    JNIEnv* env,
+    jlong handle,
+    const jni_zero::JavaRef<jbyteArray>& pcm,
+    jint offset) {
+  OpusEncoder* encoder = reinterpret_cast<OpusEncoder*>(handle);
+  // The Java side checked that a whole frame follows offset.
+  jbyte bytes[kFrameSamples * 2];
+  env->GetByteArrayRegion(pcm.obj(), offset, kFrameSamples * 2, bytes);
+  if (env->ExceptionCheck()) {
+    return nullptr;
+  }
+  opus_int16 samples[kFrameSamples];
+  for (int i = 0; i < kFrameSamples; ++i) {
+    const uint8_t lo = static_cast<uint8_t>(bytes[2 * i]);
+    const uint8_t hi = static_cast<uint8_t>(bytes[2 * i + 1]);
+    samples[i] = static_cast<opus_int16>(static_cast<uint16_t>(lo | (hi << 8)));
+  }
+  unsigned char packet[kMaxPacketBytes];
+  const opus_int32 size =
+      opus_encode(encoder, samples, kFrameSamples, packet, kMaxPacketBytes);
+  if (size < 0) {
+    return nullptr;
+  }
+  jbyteArray array = env->NewByteArray(size);
+  RTC_CHECK(array != nullptr) << "NewByteArray failed";
+  env->SetByteArrayRegion(array, 0, size, reinterpret_cast<const jbyte*>(packet));
+  return jni_zero::AdoptRef(env, array);
+}
+
+static void JNI_OpusVoiceEncoder_Free(JNIEnv* env, jlong handle) {
+  opus_encoder_destroy(reinterpret_cast<OpusEncoder*>(handle));
+}
+
+}  // namespace jni
+}  // namespace webrtc
+
+DEFINE_JNI(OpusVoiceEncoder)
