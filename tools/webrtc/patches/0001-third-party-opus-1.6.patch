diff --git opus/BUILD.gn opus/BUILD.gn
index 9b1fb42..864b110 100644
--- opus/BUILD.gn
+++ opus/BUILD.gn
@@ -5,6 +5,10 @@
 import("//build/config/arm.gni")
 import("//testing/test.gni")
 
+# deep_plc_sources, osce_sources, dnn_neon_sources (dnn_dotprod_sources is unused).
+# Written by tools/webrtc/apply.sh from opus 1.6 (lpcnet_sources.mk).
+import("dnn_sources.gni")
+
 # If ARM optimizations shall be used to accelerate performance.
 use_opus_arm_optimization = current_cpu == "arm" || current_cpu == "arm64"
 
@@ -20,15 +24,16 @@ config("opus_private_config") {
     "OPUS_EXPORT=",
     "ENABLE_HARDENING",
 
-    # Prefer alloca() over variable length arrays which are often inefficient;
-    # the opus code will automatically handle this correctly per-platform.
-    "USE_ALLOCA",
-    "HAVE_ALLOCA_H",
+    # Variable length arrays, not alloca() (libopus's own default). Opus 1.6
+    # declares a buffer in silk/dec_API.c with ALLOC() but no VARDECL() when
+    # ENABLE_OSCE_BWE is set, which compiles only in VAR_ARRAYS mode.
+    "VAR_ARRAYS",
   ]
 
   include_dirs = [
     "src",
     "src/celt",
+    "src/dnn",
     "src/silk",
     "src/silk/fixed",
     "src/silk/float",
@@ -60,6 +65,18 @@ config("opus_private_config") {
     defines += [ "OPUS_WILL_BE_SLOW" ]
   }
 
+  # Opus 1.6 neural features: Deep PLC, OSCE (LACE and NoLACE) and OSCE BWE.
+  # DRED stays off. libopus's CMake build defines ENABLE_OSCE but not
+  # ENABLE_OSCE_BWE (only configure.ac does), so it is listed here by hand.
+  # These features need the floating-point build, which this file already is:
+  # it lists only src/silk/float and never defines FIXED_POINT.
+  defines += [
+    "ENABLE_DEEP_PLC",
+    "ENABLE_OSCE",
+    "ENABLE_OSCE_BWE",
+    "PACKAGE_VERSION=\"1.6\"",
+  ]
+
   if (use_opus_x86_optimization) {
     defines += [
       # Run Time CPU Detections (RTCD) is always enabled for x86.
@@ -106,6 +123,12 @@ config("opus_private_config") {
 
     if (current_cpu == "arm64") {
       defines += [ "OPUS_ARM_PRESUME_AARCH64_NEON_INTR" ]
+
+      # The neural code uses NEON only, chosen at compile time by
+      # OPUS_ARM_PRESUME_NEON_INTR (dnn/arm/dnn_arm.h picks
+      # compute_linear_neon). No dot-product: iOS 17 still runs on the A12,
+      # which lacks it, so OPUS_ARM_*_DOTPROD stays undefined and
+      # dnn/arm/nnet_dotprod.c is not built.
     }
   }
 }
@@ -148,6 +171,7 @@ if (use_opus_x86_optimization) {
       "src/silk/x86/NSQ_sse4_1.c",
       "src/silk/x86/VAD_sse4_1.c",
       "src/silk/x86/VQ_WMat_EC_sse4_1.c",
+      "src/dnn/x86/nnet_sse4_1.c",
     ]
 
     configs -= [ "//build/config/compiler:chromium_code" ]
@@ -167,6 +191,7 @@ if (use_opus_x86_optimization) {
       "src/celt/x86/pitch_avx.c",
       "src/silk/float/x86/inner_product_FLP_avx2.c",
       "src/silk/x86/NSQ_del_dec_avx2.c",
+      "src/dnn/x86/nnet_avx2.c",
     ]
 
     configs -= [ "//build/config/compiler:chromium_code" ]
@@ -361,7 +386,6 @@ static_library("opus") {
     "src/src/opus_projection_decoder.c",
     "src/src/opus_projection_encoder.c",
     "src/src/repacketizer.c",
-    "src/src/tansig_table.h",
   ]
 
   # Silk floating-point
@@ -414,6 +438,9 @@ static_library("opus") {
     configs += [ "//build/config/compiler:optimize_speed" ]
   }
 
+  # Deep PLC and OSCE.
+  sources += deep_plc_sources + osce_sources
+
   deps = []
 
   if (use_opus_x86_optimization) {
@@ -431,6 +458,8 @@ static_library("opus") {
       "src/silk/x86/SigProc_FIX_sse.h",
       "src/silk/x86/main_sse.h",
       "src/silk/x86/x86_silk_map.c",
+      "src/dnn/x86/nnet_sse2.c",
+      "src/dnn/x86/x86_dnn_map.c",
     ]
     deps += [
       ":opus_avx2",
@@ -462,6 +491,10 @@ static_library("opus") {
       "src/silk/arm/macros_armv4.h",
       "src/silk/arm/macros_armv5e.h",
     ]
+
+    if (current_cpu == "arm64") {
+      sources += dnn_neon_sources
+    }
   }
 }
 
