diff --git a/sdk/android/api/org/webrtc/AudioCapturePostProcessing.java b/sdk/android/api/org/webrtc/AudioCapturePostProcessing.java
new file mode 100644
index 0000000..fa6d603
--- /dev/null
+++ b/sdk/android/api/org/webrtc/AudioCapturePostProcessing.java
@@ -0,0 +1,83 @@
+/*
+ *  Application patch (tools/webrtc/patches/0007): a writable hook on captured
+ *  audio. The upstream Java SDK has no way to edit it. The Android form of
+ *  RTCAudioCapturePostProcessing (patch 0004).
+ *
+ *  The hook runs inside WebRTC's audio processing module, after its echo
+ *  cancellation and noise suppression. Pass an instance to
+ *  PeerConnectionFactory.Builder.setAudioProcessingFactory.
+ *
+ *  The processor is native code behind a C struct (see
+ *  src/jni/app/audio_capture_processor.h in the WebRTC source, and
+ *  AppAudioCaptureProcessor), so audio frames never cross JNI into Java.
+ *  `nativeProcessor` is the address of that struct. createNative reads the
+ *  struct and from then on the audio processing module owns `context` and calls
+ *  `destroy` when it is freed. If createNative is never called, the caller still
+ *  owns the context. The object is single use (a second createNative or selfTest
+ *  throws IllegalStateException), so a context cannot be destroyed twice.
+ */
+
+package org.webrtc;
+
+import org.jni_zero.NativeMethods;
+
+public class AudioCapturePostProcessing implements AudioProcessingFactory {
+  // Zeroed by the first take; guarded by `this`.
+  private long nativeProcessor;
+
+  /**
+   * Single use: the processor is consumed by the first createNative or selfTest, and a second one
+   * throws IllegalStateException. The AppAudioCaptureProcessor struct must stay valid until that
+   * call returns (it is read then, not here).
+   *
+   * @param nativeProcessor address of an AppAudioCaptureProcessor, not 0
+   */
+  public AudioCapturePostProcessing(long nativeProcessor) {
+    if (nativeProcessor == 0) {
+      throw new IllegalArgumentException("nativeProcessor must not be 0");
+    }
+    this.nativeProcessor = nativeProcessor;
+  }
+
+  /** Always true in this build. Lets code check that the hook exists. */
+  public static boolean hasCapturePostProcessingHook() {
+    return true;
+  }
+
+  private synchronized long take() {
+    if (nativeProcessor == 0) {
+      throw new IllegalStateException("AudioCapturePostProcessing is single use and was already used");
+    }
+    long handle = nativeProcessor;
+    nativeProcessor = 0;
+    return handle;
+  }
+
+  @Override
+  public long createNative(long webrtcEnvRef) {
+    return AudioCapturePostProcessingJni.get().create(webrtcEnvRef, take());
+  }
+
+  /**
+   * Test hook: runs one 10 ms 48 kHz mono frame of constant 0.5 through an audio processing
+   * module built with this processor and every built-in stage off, and returns the output samples
+   * (empty if processing failed). Consumes the processor, as createNative does.
+   */
+  public float[] selfTest() {
+    return AudioCapturePostProcessingJni.get().selfTest(take());
+  }
+
+  /**
+   * Like selfTest, with a built-in processor that halves the samples: the result is 480 samples
+   * of 0.25. Proves the hook is compiled in without any native processor.
+   */
+  public static float[] selfTestBuiltin() {
+    return AudioCapturePostProcessingJni.get().selfTest(0);
+  }
+
+  @NativeMethods
+  interface Natives { // Parameters are not named native<Class>: jni_zero would make that a pointer type.
+    long create(long webrtcEnvRef, long processorHandle);
+    float[] selfTest(long processorHandle);
+  }
+}
diff --git a/sdk/android/src/jni/app/audio_capture_post_processing.cc b/sdk/android/src/jni/app/audio_capture_post_processing.cc
new file mode 100644
index 0000000..0aa2c61
--- /dev/null
+++ b/sdk/android/src/jni/app/audio_capture_post_processing.cc
@@ -0,0 +1,175 @@
+/*
+ *  Application patch (tools/webrtc/patches/0007). See
+ *  api/org/webrtc/AudioCapturePostProcessing.java and audio_capture_processor.h.
+ */
+
+#include <jni.h>
+#include <stddef.h>
+
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "api/audio/audio_processing.h"
+#include "api/audio/builtin_audio_processing_builder.h"
+#include "api/environment/environment.h"
+#include "api/environment/environment_factory.h"
+#include "api/scoped_refptr.h"
+#include "modules/audio_processing/audio_buffer.h"
+#include "rtc_base/checks.h"
+#include "sdk/android/generated_capture_post_processing_jni/AudioCapturePostProcessing_jni.h"
+#include "sdk/android/native_api/jni/java_types.h"
+#include "sdk/android/src/jni/app/audio_capture_processor.h"
+#include "third_party/jni_zero/jni_zero.h"
+
+namespace webrtc {
+namespace jni {
+namespace {
+
+// AudioBuffer holds samples in the FloatS16 range [-32768, 32767]. The
+// processor sees [-1, 1]. 32768 is a power of two, so scaling there and back is
+// exact.
+constexpr float kToUnit = 1.0f / 32768.0f;
+constexpr float kFromUnit = 32768.0f;
+
+// Owns the processor's context from construction on.
+class CapturePostProcessingAdapter final : public CustomProcessing {
+ public:
+  explicit CapturePostProcessingAdapter(const AppAudioCaptureProcessor& processor)
+      : processor_(processor) {}
+  ~CapturePostProcessingAdapter() override {
+    if (processor_.destroy) {
+      processor_.destroy(processor_.context);
+    }
+  }
+
+  void Initialize(int sample_rate_hz, int num_channels) override {
+    if (processor_.initialize) {
+      processor_.initialize(processor_.context, sample_rate_hz, num_channels);
+    }
+    if (initialized_ && processor_.reset) {
+      processor_.reset(processor_.context);
+    }
+    initialized_ = true;
+  }
+
+  void Process(AudioBuffer* audio) override {
+    const size_t channels = audio->num_channels();
+    const size_t frames = audio->num_frames();
+    // The processor edits the AudioBuffer's own channel pointers in place, so
+    // nothing is copied or allocated here.
+    float* const* data = audio->channels();
+    for (size_t c = 0; c < channels; ++c) {
+      for (size_t i = 0; i < frames; ++i) {
+        data[c][i] *= kToUnit;
+      }
+    }
+    processor_.process(processor_.context, data, frames, channels);
+    for (size_t c = 0; c < channels; ++c) {
+      for (size_t i = 0; i < frames; ++i) {
+        data[c][i] *= kFromUnit;
+      }
+    }
+  }
+
+  std::string ToString() const override { return "AppCapturePostProcessing"; }
+
+ private:
+  const AppAudioCaptureProcessor processor_;
+  bool initialized_ = false;
+};
+
+jni_zero::ScopedJavaLocalRef<jfloatArray> ToJavaFloatArray(JNIEnv* env,
+                                                           const float* data,
+                                                           size_t size) {
+  jfloatArray array = env->NewFloatArray(static_cast<jsize>(size));
+  RTC_CHECK(array != nullptr) << "NewFloatArray failed";
+  if (size > 0) {
+    env->SetFloatArrayRegion(array, 0, static_cast<jsize>(size), data);
+  }
+  return jni_zero::AdoptRef(env, array);
+}
+
+// The processor `selfTestBuiltin` uses: halves every sample.
+void HalveProcess(void*, float* const* channels, size_t num_frames, size_t num_channels) {
+  for (size_t c = 0; c < num_channels; ++c) {
+    for (size_t i = 0; i < num_frames; ++i) {
+      channels[c][i] *= 0.5f;
+    }
+  }
+}
+
+scoped_refptr<AudioProcessing> Build(const Environment& env,
+                                     const AppAudioCaptureProcessor& processor,
+                                     const AudioProcessing::Config& config) {
+  RTC_CHECK_EQ(processor.abi_version, APP_AUDIO_CAPTURE_PROCESSOR_ABI_VERSION)
+      << "AppAudioCaptureProcessor has the wrong abi_version";
+  RTC_CHECK(processor.process != nullptr) << "AppAudioCaptureProcessor.process is null";
+  BuiltinAudioProcessingBuilder builder(config);
+  builder.SetCapturePostProcessing(std::make_unique<CapturePostProcessingAdapter>(processor));
+  return builder.Build(env);
+}
+
+}  // namespace
+
+// Returns an owning pointer to the AudioProcessing: the reference is taken over
+// by PeerConnectionFactory (see peer_connection_factory.cc, same patch).
+static jlong JNI_AudioCapturePostProcessing_Create(JNIEnv* env,
+                                                   jlong webrtc_env_ref,
+                                                   jlong native_processor) {
+  const Environment* webrtc_env = reinterpret_cast<Environment*>(webrtc_env_ref);
+  RTC_CHECK(webrtc_env != nullptr);
+  const AppAudioCaptureProcessor* processor =
+      reinterpret_cast<const AppAudioCaptureProcessor*>(native_processor);
+  RTC_CHECK(processor != nullptr);
+  scoped_refptr<AudioProcessing> apm = Build(*webrtc_env, *processor, AudioProcessing::Config());
+  RTC_CHECK(apm) << "Failed to create the audio processing module";
+  return NativeToJavaPointer(apm.release());
+}
+
+static jni_zero::ScopedJavaLocalRef<jfloatArray> JNI_AudioCapturePostProcessing_SelfTest(
+    JNIEnv* env,
+    jlong native_processor) {
+  AppAudioCaptureProcessor builtin = {APP_AUDIO_CAPTURE_PROCESSOR_ABI_VERSION,
+                                      nullptr,
+                                      nullptr,
+                                      &HalveProcess,
+                                      nullptr,
+                                      nullptr};
+  const AppAudioCaptureProcessor* processor =
+      native_processor == 0 ? &builtin
+                            : reinterpret_cast<const AppAudioCaptureProcessor*>(native_processor);
+
+  // Every built-in stage off, so the only thing that can change the frame is
+  // the processor.
+  AudioProcessing::Config config;
+  config.pre_amplifier.enabled = false;
+  config.capture_level_adjustment.enabled = false;
+  config.high_pass_filter.enabled = false;
+  config.echo_canceller.enabled = false;
+  config.noise_suppression.enabled = false;
+  config.gain_controller1.enabled = false;
+  config.gain_controller2.enabled = false;
+
+  scoped_refptr<AudioProcessing> apm = Build(CreateEnvironment(), *processor, config);
+  if (!apm) {
+    return ToJavaFloatArray(env, nullptr, 0);
+  }
+
+  constexpr int kRateHz = 48000;
+  constexpr size_t kFrames = kRateHz / 100;  // 10 ms
+  std::vector<float> in(kFrames, 0.5f);
+  std::vector<float> out(kFrames, 0.0f);
+  const float* src[1] = {in.data()};
+  float* dest[1] = {out.data()};
+  const StreamConfig stream(kRateHz, /*num_channels=*/1);
+  if (apm->ProcessStream(src, stream, stream, dest) != AudioProcessing::kNoError) {
+    return ToJavaFloatArray(env, nullptr, 0);
+  }
+  return ToJavaFloatArray(env, out.data(), out.size());
+}
+
+}  // namespace jni
+}  // namespace webrtc
+
+DEFINE_JNI(AudioCapturePostProcessing)
diff --git a/sdk/android/src/jni/app/audio_capture_processor.h b/sdk/android/src/jni/app/audio_capture_processor.h
new file mode 100644
index 0000000..80a091f
--- /dev/null
+++ b/sdk/android/src/jni/app/audio_capture_processor.h
@@ -0,0 +1,59 @@
+/*
+ *  Application patch (tools/webrtc/patches/0007): the C interface a native
+ *  library implements to edit captured audio. It is plain C so that a separate
+ *  shared library (libjingle_peerconnection_so exports nothing but its JNI
+ *  functions) can fill in the struct without linking against WebRTC.
+ *
+ *  The app passes the address of an AppAudioCaptureProcessor to the Java class
+ *  org.webrtc.AudioCapturePostProcessing as a long. Audio frames stay in native
+ *  memory: nothing is copied to Java.
+ *
+ *  The struct must stay valid until createNative (or selfTest) returns: it is
+ *  read then, not when the Java object is made. It is copied, so it may be freed
+ *  afterwards. From then on WebRTC owns `context` and calls `destroy` once. The
+ *  Java object is single use, so one struct is never consumed twice.
+ */
+
+#ifndef SDK_ANDROID_SRC_JNI_APP_AUDIO_CAPTURE_PROCESSOR_H_
+#define SDK_ANDROID_SRC_JNI_APP_AUDIO_CAPTURE_PROCESSOR_H_
+
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Version 1. */
+#define APP_AUDIO_CAPTURE_PROCESSOR_ABI_VERSION 1
+
+typedef struct AppAudioCaptureProcessor {
+  /* Must be APP_AUDIO_CAPTURE_PROCESSOR_ABI_VERSION. */
+  uint32_t abi_version;
+
+  /* Passed to every function below. */
+  void* context;
+
+  /* Called before the first frame and again whenever the audio pipeline is
+   * re-initialised. After any re-initialisation, `reset` follows. May run on
+   * a thread other than the audio thread. */
+  void (*initialize)(void* context, int sample_rate_hz, int num_channels);
+
+  /* Called on the audio thread, once per 10 ms frame; must not block or
+   * allocate. Full-band float samples in [-1, 1], one buffer per channel;
+   * modify in place. */
+  void (*process)(void* context, float* const* channels, size_t num_frames, size_t num_channels);
+
+  /* Drop any history. Called after every re-initialisation, that is after each
+   * `initialize` except the first. */
+  void (*reset)(void* context);
+
+  /* Called once, when WebRTC's audio processing is destroyed. */
+  void (*destroy)(void* context);
+} AppAudioCaptureProcessor;
+
+#ifdef __cplusplus
+}  /* extern "C" */
+#endif
+
+#endif  /* SDK_ANDROID_SRC_JNI_APP_AUDIO_CAPTURE_PROCESSOR_H_ */
