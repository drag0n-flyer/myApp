diff --git a/webrtc.gni b/webrtc.gni
index 82cb3af..a85867a 100644
--- a/webrtc.gni
+++ b/webrtc.gni
@@ -1163,6 +1163,7 @@ if (is_mac || is_ios) {
         # This is the fix. The mac framework now has a direct dependency on
         # the creation of the privacy manifest, just like the iOS version.
         deps += [
+          ":copy_bracket_headers_$this_target_name",
           ":copy_modulemap_$this_target_name",
           ":copy_umbrella_header_$this_target_name",
           ":create_bracket_include_headers_$this_target_name",
@@ -1261,6 +1262,16 @@ if (is_mac || is_ios) {
         ]
         deps = [ ":umbrella_header_$this_target_name" ]
       }
+
+      # App patch (tools/webrtc/patches/0005): upstream copies only the umbrella
+      # header into the macOS framework, so the umbrella's own #import lines
+      # fail. Copy every public header like the iOS framework does.
+      copy("copy_bracket_headers_$this_target_name") {
+        sources = get_target_outputs(
+                ":create_bracket_include_headers_$this_target_name")
+        outputs = [ "$root_out_dir/$output_name.framework/$headers_dir/{{source_file_part}}" ]
+        deps = [ ":create_bracket_include_headers_$this_target_name" ]
+      }
     }
   }
 }
