# Settings for running the server on this machine with make (no Docker Compose).
#   make env    copies this file to .env (once); then edit .env
#   make db     starts PostgreSQL in Docker with POSTGRES_PASSWORD below
#   make run    starts the server with .env
# Every setting, with explanations: deploy/.env.example. Never commit .env.

# Database. Change the password in both lines (percent-encode @ : / in the URL).
POSTGRES_PASSWORD=change-me
APP_DATABASE_URL=postgres://appserver:change-me@127.0.0.1:5432/appserver?sslmode=disable

# Your server's public name (the one the apps connect to).
APP_HOST=chat.example.org

# Chat API address. 0.0.0.0 accepts other machines; 127.0.0.1 only this one.
APP_LISTEN=0.0.0.0:8080
# Admin dashboard: keep on 127.0.0.1, reach it with ssh -L 9090:127.0.0.1:9090 your-server
APP_ADMIN_LISTEN=127.0.0.1:9090

# true only behind a reverse proxy (Caddy, nginx) that sets X-Forwarded-For.
APP_TRUST_PROXY=false

# Where uploads are kept.
APP_DATA_DIR=./data

# Email for sign-up and sign-in codes: smtp://USERNAME:PASSWORD@SMTP_HOST:587 (STARTTLS).
# Empty: no email is sent, so nobody can sign up or sign in by email code.
APP_SMTP_URL=
APP_MAIL_FROM=

# Optional: calls through TURN relays, push notifications, passkeys for the apps.
# See deploy/.env.example for these.
# APP_TURN_SECRET=
# APP_RELAYS=
# APP_PUSH_GATEWAY_URL=
# APP_PUSH_KEY_FILE=
# APP_PUSH_SERVER_ID=
# APP_APPLE_APP_IDS=
# APP_ANDROID_APPS=
