# Copy to .env and edit it. Never commit .env.
# Placeholders only: create the real values on the gateway host, with umask 077.
PUSH_HOST=push.example.org
PUSHGW_DB_PASSWORD=
PUSHGW_APNS_KEY_ID=
PUSHGW_APNS_TEAM_ID=
PUSHGW_BUNDLE_IDS=org.example.app,org.example.app.mac
# Key files, read-only, from /etc/pushgw/keys on the host (owner 65532, mode 0400).
PUSHGW_HPKE_KEY_FILE=/keys/pushgw-hpke.pem
PUSHGW_APNS_KEY_FILE=/keys/apns.p8
