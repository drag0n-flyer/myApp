# Copy to .env and edit. Never commit .env.
POSTGRES_PASSWORD=change-me

# Required
APP_HOST=chat.example.org
# APP_DATABASE_URL is set by compose.yaml from POSTGRES_PASSWORD.

# Optional (defaults in brackets)
APP_LISTEN=:8080
APP_ADMIN_LISTEN=127.0.0.1:9090
APP_DATA_DIR=/var/lib/appserver
APP_POLICY_FILE=
# Email for sign-up and sign-in codes (OTP), sent through your SMTP server.
# Form: smtp://USERNAME:PASSWORD@SMTP_HOST:587. The server uses STARTTLS on port 587 and refuses plain text.
# Percent-encode special characters in the username or password (@ -> %40, : -> %3A, / -> %2F).
# Left empty, no email is sent and nobody can sign up or sign in by email code.
APP_SMTP_URL=smtp://USERNAME:PASSWORD@smtp.example.org:587
# Sender address; your SMTP provider must allow sending from it. [no-reply@APP_HOST]
APP_MAIL_FROM=no-reply@chat.example.org
APP_TURN_SECRET=change-me-long-random
APP_RELAYS=turn1.example.org@eu,turn2.example.org@us
APP_PUSH_GATEWAY_URL=https://push.example.org
APP_PUSH_KEY_FILE=/secrets/push.pem
APP_PUSH_SERVER_ID=
APP_ESCROW_KEY_FILE=/secrets/escrow.pem
# iPhone app and Mac app, comma separated: TEAMID.bundle.id
APP_APPLE_APP_IDS=TEAMID.org.example.app,TEAMID.org.example.app.mac
# true only behind a reverse proxy that sets X-Forwarded-For
APP_TRUST_PROXY=true
# security.txt and legal pages, served from deploy/docs (mounted at /docs by compose)
APP_DOCS_DIR=/docs

# Push gateway (only with: docker compose --profile gateway up -d)
PUSHGW_HPKE_KEY_FILE=/secrets/pushgw-hpke.pem
PUSHGW_APNS_KEY_FILE=/secrets/apns.p8
PUSHGW_APNS_KEY_ID=
PUSHGW_APNS_TEAM_ID=
PUSHGW_BUNDLE_IDS=org.example.app,org.example.app.mac
PUSHGW_TRUST_PROXY=true
# Password of the gateway's own database role (empty = no gateway database)
PUSHGW_DB_PASSWORD=
